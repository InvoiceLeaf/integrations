{
  "name": "@invoiceleaf/integration-telegram-bot",
  "version": "1.0.3",
  "description": "Telegram bot integration payload builders for InvoiceLeaf",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "invoiceleaf",
    "integration",
    "telegram",
    "bot",
    "notifications"
  ],
  "author": "InvoiceLeaf <support@invoiceleaf.com>",
  "license": "MIT",
  "peerDependencies": {
    "@invoiceleaf/integration-sdk": "^1.7.0"
  },
  "devDependencies": {
    "@invoiceleaf/integration-sdk": "^1.7.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md"
  ]
}

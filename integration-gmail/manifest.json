{
  "id": "integration-gmail",
  "name": "Gmail",
  "description": "Import PDF attachments from Gmail into InvoiceLeaf using OAuth.",
  "version": "1.1.1",
  "author": {
    "name": "InvoiceLeaf",
    "email": "support@invoiceleaf.com",
    "url": "https://invoiceleaf.com"
  },
  "icon": "mail",
  "iconUrl": "https://app.invoiceleaf.com/img/integrations/gmail.png",
  "category": "communication",
  "tags": [
    "gmail",
    "google",
    "email",
    "inbox",
    "attachments"
  ],
  "dataAccess": [
    "documents"
  ],
  "externalAuth": [
    {
      "provider": "gmail",
      "name": "Gmail",
      "type": "oauth2",
      "oauth": {
        "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenUrl": "https://oauth2.googleapis.com/token",
        "scopes": [
          "https://www.googleapis.com/auth/gmail.readonly",
          "openid",
          "email",
          "profile"
        ],
        "pkceRequired": true,
        "authorizeParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "appCredentials": {
        "registrationUrl": "https://console.cloud.google.com/apis/credentials",
        "instructions": "Create an OAuth 2.0 Client ID of type Web application in Google Cloud, enable the Gmail API, and add the redirect URI below as an authorised redirect URI. While the OAuth consent screen is in Testing, Google expires refresh tokens after 7 days, so publish it. gmail.readonly is a restricted scope: publishing requires Google verification including an annual CASA security assessment.",
        "fields": [
          {
            "key": "clientId",
            "label": "Client ID",
            "description": "Public identifier of the app you registered with the provider."
          },
          {
            "key": "clientSecret",
            "label": "Client secret",
            "secret": true,
            "description": "Stored encrypted. Shown only as a masked placeholder once saved."
          },
          {
            "key": "redirectUri",
            "label": "Redirect URI",
            "description": "Must match a redirect URI registered with the provider, character for character.",
            "default": "https://app.invoiceleaf.com/integrations/oauth/callback"
          }
        ]
      }
    }
  ],
  "triggers": [
    {
      "id": "crawl-gmail-pdf-attachments",
      "type": "schedule",
      "name": "Crawl Gmail PDF Attachments",
      "description": "Checks Gmail for PDF attachments and imports them into InvoiceLeaf",
      "schedule": "*/15 * * * *",
      "handler": "crawlPdfAttachments",
      "configurable": true
    }
  ],
  "actions": [
    {
      "id": "test-connection",
      "name": "Test Gmail Connection",
      "description": "Verify Gmail OAuth credentials",
      "handler": "testConnection",
      "icon": "check"
    },
    {
      "id": "crawl-now",
      "name": "Crawl Gmail Now",
      "description": "Run Gmail attachment crawl immediately",
      "handler": "crawlPdfAttachments",
      "icon": "refresh"
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "title": "Gmail Search Query",
        "description": "Gmail search query used to find messages with PDF attachments.",
        "default": "has:attachment filename:pdf newer_than:30d"
      },
      "includeSpamTrash": {
        "type": "boolean",
        "title": "Include Spam/Trash",
        "default": false
      },
      "maxMessagesPerRun": {
        "type": "number",
        "title": "Max Messages Per Run",
        "default": 100,
        "minimum": 1,
        "maximum": 500
      },
      "maxAttachmentsPerMessage": {
        "type": "number",
        "title": "Max Attachments Per Message",
        "default": 10,
        "minimum": 1,
        "maximum": 50
      },
      "stateKeyPrefix": {
        "type": "string",
        "title": "State Key Prefix",
        "default": "gmail"
      },
      "dedupeTtlSeconds": {
        "type": "number",
        "title": "Dedupe TTL (seconds)",
        "default": 7776000,
        "minimum": 3600
      },
      "importSource": {
        "type": "string",
        "title": "Import Source",
        "default": "gmail"
      }
    }
  },
  "ui": {
    "configGroups": [
      {
        "title": "Mailbox Query",
        "description": "Configure which Gmail messages are scanned",
        "fields": [
          "query",
          "includeSpamTrash"
        ]
      },
      {
        "title": "Crawler Limits",
        "description": "Control per-run workload and dedupe",
        "fields": [
          "maxMessagesPerRun",
          "maxAttachmentsPerMessage",
          "stateKeyPrefix",
          "dedupeTtlSeconds",
          "importSource"
        ]
      }
    ]
  }
}
